HOST=127.0.0.1
PORT=5178
APP_DATA_DIR=data
APP_STORAGE_ROOT=work
APP_OUTPUT_ROOT=output
APP_MUSIC_ROOT=music
APP_MUSIC_CATALOG=config/music/tracks.json

# Optional local AI services. Keep these bound to loopback unless you intentionally
# secure and expose them on another interface.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# COMFY_BASE_URL=http://127.0.0.1:8188
# COMFY_WORKFLOW_PATH=config/comfy/image-to-video-api.json

# Optional overrides. The app otherwise uses its matched bundled pair.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
# REMOTION_BROWSER_EXECUTABLE=C:\path\to\chrome.exe
